@model PAP.DataAccess.Review
@{ ViewBag.Title = "Details Review"; }
<h2>Details Review</h2>

<dl class="dl-horizontal"><dt>Id</dt><dd>@Model.Id</dd>
<dt>BookId</dt><dd>@Model.BookId</dd>
<dt>CustomerId</dt><dd>@Model.CustomerId</dd>
<dt>Comment</dt><dd>@Model.Comment</dd>
<dt>CreatedAt</dt><dd>@Model.CreatedAt</dd></dl>
@Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning" })
@Html.ActionLink("Volver", "Index")
