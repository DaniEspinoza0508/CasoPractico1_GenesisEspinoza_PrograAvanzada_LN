@model PAP.DataAccess.OrderItem
@{ ViewBag.Title = "Delete OrderItem"; }
<h2>Delete OrderItem</h2>
<p>¿Confirma que desea eliminar este registro?</p>
<dl class="dl-horizontal"><dt>Id</dt><dd>@Model.Id</dd>
<dt>OrderId</dt><dd>@Model.OrderId</dd>
<dt>BookId</dt><dd>@Model.BookId</dd>
<dt>Quantity</dt><dd>@Model.Quantity</dd>
<dt>UnitPrice</dt><dd>@Model.UnitPrice</dd>
<dt>Discount</dt><dd>@Model.Discount</dd></dl>
@using (Html.BeginForm("Delete", "OrderItems", new { id = Model.Id }, FormMethod.Post)) {
@Html.AntiForgeryToken()
<button type="submit" class="btn btn-danger">Eliminar</button>
}
@Html.ActionLink("Volver", "Index")
