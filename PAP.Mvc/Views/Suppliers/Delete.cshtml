
@model PAP.DataAccess.Supplier

@{
    ViewBag.Title = "Delete Supplier";
}

<h2>Delete Supplier</h2>

<h4>Are you sure you want to delete this supplier?</h4>

<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Contact</dt>
    <dd class="col-sm-9">@Model.ContactName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.Phone</dd>

    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@Model.Address</dd>

    <dt class="col-sm-3">Active</dt>
    <dd class="col-sm-9">
        @(Model.IsActive ? "Yes" : "No")
    </dd>
</dl>

@using (Html.BeginForm("Delete", "Suppliers",
    new { id = Model.Id }, FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    @Html.ActionLink("Cancel", "Index", null,
        new { @class = "btn btn-secondary" })
}
