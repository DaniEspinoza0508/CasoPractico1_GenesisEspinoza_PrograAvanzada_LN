
@model IEnumerable<PAP.DataAccess.Book>

@{
    ViewBag.Title = "Books";
    var books = Model?.ToList() ?? new List<PAP.DataAccess.Book>();
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-4">Books</h1>
            <p class="text-muted mb-0">
                @books.Count title@(books.Count == 1 ? "" : "s") in the catalog
            </p>
        </div>

        <div>
            @Html.ActionLink(
                "Vista cards",
                "Catalog",
                "Library",
                new { vista = "cards" },
                new { @class = "btn btn-outline-dark btn-sm" })

            @Html.ActionLink(
                "Crear libro",
                "Create",
                "Library",
                null,
                new { @class = "btn btn-primary btn-sm" })
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-info" role="alert">
            @TempData["Mensaje"]
        </div>
    }

    @if (!books.Any())
    {
        <div class="alert alert-info" role="alert">
            No books are available at this time.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Title</th>
                        <th scope="col">Author</th>
                        <th scope="col">Genre</th>
                        <th scope="col">Category</th>
                        <th scope="col">Publisher</th>
                        <th scope="col">Published</th>
                        <th scope="col" class="text-end">Price</th>
                        <th scope="col">Status</th>
                        <th scope="col">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var book in books)
                    {
                        <tr>
                            <td>@book.Id</td>
                            <td>@book.Title</td>
                            <td>@book.Author</td>
                            <td>@book.Genre</td>
                            <td>@book.Category</td>
                            <td>@book.Publisher</td>

                            <td>
                                @(book.PublicationDate.HasValue
                                    ? book.PublicationDate.Value.ToString("dd/MM/yyyy")
                                    : "-")
                            </td>

                            <td class="text-end">
                                @book.Price.ToString("C")
                            </td>

                            <td>
                                @if (book.IsInStock)
                                {
                                    <span class="badge bg-success">In stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Out of stock</span>
                                }
                            </td>

                            <td>
                                @Html.ActionLink(
                                    "Editar",
                                    "Edit",
                                    "Library",
                                    new { id = book.Id },
                                    new { @class = "btn btn-warning btn-sm" })

                                @Html.ActionLink(
                                    "Eliminar",
                                    "Delete",
                                    "Library",
                                    new { id = book.Id },
                                    new { @class = "btn btn-danger btn-sm" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
