
@{
    ViewBag.Title = "Asignar autor a libro";
}

<h2>Asignar autor a libro</h2>

@using (Html.BeginForm("Create", "BookAuthors", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "",
        new { @class = "text-danger" })

    <div class="form-group">
        <label>Libro</label>
        @Html.DropDownList("bookId",
            (SelectList)ViewBag.BookId,
            "-- Seleccione un libro --",
            new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Autor</label>
        @Html.DropDownList("authorId",
            (SelectList)ViewBag.AuthorId,
            "-- Seleccione un autor --",
            new { @class = "form-control" })
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

    @Html.ActionLink("Volver", "Index", "BookAuthors",
        null, new { @class = "btn btn-secondary" })
}
