@model PAP.DataAccess.Author
@{ ViewBag.Title = "Delete Author"; }
<h2>Delete Author</h2>
<p>¿Confirma que desea eliminar este registro?</p>
<dl class="dl-horizontal"><dt>Id</dt><dd>@Model.Id</dd>
<dt>FirstName</dt><dd>@Model.FirstName</dd>
<dt>LastName</dt><dd>@Model.LastName</dd>
<dt>Biography</dt><dd>@Model.Biography</dd>
<dt>BirthDate</dt><dd>@Model.BirthDate</dd>
<dt>Country</dt><dd>@Model.Country</dd>
<dt>CreatedAt</dt><dd>@Model.CreatedAt</dd></dl>
@using (Html.BeginForm("Delete", "Authors", new { id = Model.Id }, FormMethod.Post)) {
@Html.AntiForgeryToken()
<button type="submit" class="btn btn-danger">Eliminar</button>
}
@Html.ActionLink("Volver", "Index")
