@model PAP.DataAccess.Order
@{ ViewBag.Title = "Delete Order"; }
<h2>Delete Order</h2>
<p>¿Confirma que desea eliminar este registro?</p>
<dl class="dl-horizontal"><dt>Id</dt><dd>@Model.Id</dd>
<dt>CustomerId</dt><dd>@Model.CustomerId</dd>
<dt>ShippingAddressId</dt><dd>@Model.ShippingAddressId</dd>
<dt>OrderDate</dt><dd>@Model.OrderDate</dd>
<dt>Status</dt><dd>@Model.Status</dd>
<dt>Subtotal</dt><dd>@Model.Subtotal</dd>
<dt>TaxAmount</dt><dd>@Model.TaxAmount</dd>
<dt>ShippingCost</dt><dd>@Model.ShippingCost</dd>
<dt>Total</dt><dd>@Model.Total</dd>
<dt>Notes</dt><dd>@Model.Notes</dd>
<dt>UpdatedAt</dt><dd>@Model.UpdatedAt</dd></dl>
@using (Html.BeginForm("Delete", "Orders", new { id = Model.Id }, FormMethod.Post)) {
@Html.AntiForgeryToken()
<button type="submit" class="btn btn-danger">Eliminar</button>
}
@Html.ActionLink("Volver", "Index")
