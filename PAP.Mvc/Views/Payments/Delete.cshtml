@model PAP.DataAccess.Payment
@{ ViewBag.Title = "Delete Payment"; }
<h2>Delete Payment</h2>
<p>¿Confirma que desea eliminar este registro?</p>
<dl class="dl-horizontal"><dt>Id</dt><dd>@Model.Id</dd>
<dt>OrderId</dt><dd>@Model.OrderId</dd>
<dt>PaymentMethod</dt><dd>@Model.PaymentMethod</dd>
<dt>Amount</dt><dd>@Model.Amount</dd>
<dt>PaymentDate</dt><dd>@Model.PaymentDate</dd>
<dt>Status</dt><dd>@Model.Status</dd>
<dt>TransactionRef</dt><dd>@Model.TransactionRef</dd></dl>
@using (Html.BeginForm("Delete", "Payments", new { id = Model.Id }, FormMethod.Post)) {
@Html.AntiForgeryToken()
<button type="submit" class="btn btn-danger">Eliminar</button>
}
@Html.ActionLink("Volver", "Index")
