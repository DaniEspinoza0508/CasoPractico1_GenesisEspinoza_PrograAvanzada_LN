@model PAP.DataAccess.CartItem
@{ ViewBag.Title = "Details CartItem"; }
<h2>Details CartItem</h2>

<dl class="dl-horizontal"><dt>Id</dt><dd>@Model.Id</dd>
<dt>CartId</dt><dd>@Model.CartId</dd>
<dt>BookId</dt><dd>@Model.BookId</dd>
<dt>Quantity</dt><dd>@Model.Quantity</dd>
<dt>AddedAt</dt><dd>@Model.AddedAt</dd></dl>
@Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning" })
@Html.ActionLink("Volver", "Index")
