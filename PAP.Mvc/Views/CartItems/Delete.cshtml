@model PAP.DataAccess.CartItem
@{ ViewBag.Title = "Delete CartItem"; }
<h2>Delete CartItem</h2>
<p>¿Confirma que desea eliminar este registro?</p>
<dl class="dl-horizontal"><dt>Id</dt><dd>@Model.Id</dd>
<dt>CartId</dt><dd>@Model.CartId</dd>
<dt>BookId</dt><dd>@Model.BookId</dd>
<dt>Quantity</dt><dd>@Model.Quantity</dd>
<dt>AddedAt</dt><dd>@Model.AddedAt</dd></dl>
@using (Html.BeginForm("Delete", "CartItems", new { id = Model.Id }, FormMethod.Post)) {
@Html.AntiForgeryToken()
<button type="submit" class="btn btn-danger">Eliminar</button>
}
@Html.ActionLink("Volver", "Index")
