@model IEnumerable<PAP.DataAccess.CartItem>
@{ ViewBag.Title = "CartItems"; }
<h2>CartItems</h2>
<p>@Html.ActionLink("Crear nuevo", "Create", null, new { @class = "btn btn-primary" })</p>
<div style="overflow-x:auto">
<table class="table table-striped table-bordered">
<thead><tr>
                <th>Id</th>
                <th>CartId</th>
                <th>BookId</th>
                <th>Quantity</th>
                <th>AddedAt</th>
<th>Acciones</th></tr></thead>
<tbody>
@foreach (var item in Model) {
<tr>
                <td>@item.Id</td>
                <td>@item.CartId</td>
                <td>@item.BookId</td>
                <td>@item.Quantity</td>
                <td>@item.AddedAt</td>
<td>
@Html.ActionLink("Editar", "Edit", new { id = item.Id }) |
@Html.ActionLink("Detalles", "Details", new { id = item.Id }) |
@Html.ActionLink("Eliminar", "Delete", new { id = item.Id })
</td></tr>
}
</tbody></table></div>
