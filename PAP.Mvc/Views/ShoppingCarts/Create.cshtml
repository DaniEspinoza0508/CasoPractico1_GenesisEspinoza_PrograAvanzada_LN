@model PAP.DataAccess.ShoppingCart
@{ ViewBag.Title = "Create ShoppingCart"; }
<h2>Create ShoppingCart</h2>
@using (Html.BeginForm()) {
@Html.AntiForgeryToken()
@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<div class="form-group">@Html.LabelFor(m => m.CustomerId)
@Html.DropDownList("CustomerId", null, "-- Seleccionar --", new { @class = "form-control" })
@Html.ValidationMessageFor(m => m.CustomerId, "", new { @class = "text-danger" })</div>
<button type="submit" class="btn btn-primary">Guardar</button>
@Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary" })
}
