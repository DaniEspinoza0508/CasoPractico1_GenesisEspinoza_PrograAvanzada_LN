@model PAP.DataAccess.ShoppingCart
@{ ViewBag.Title = "Delete ShoppingCart"; }
<h2>Delete ShoppingCart</h2>
<p>¿Confirma que desea eliminar este registro?</p>
<dl class="dl-horizontal"><dt>Id</dt><dd>@Model.Id</dd>
<dt>CustomerId</dt><dd>@Model.CustomerId</dd>
<dt>CreatedAt</dt><dd>@Model.CreatedAt</dd>
<dt>UpdatedAt</dt><dd>@Model.UpdatedAt</dd></dl>
@using (Html.BeginForm("Delete", "ShoppingCarts", new { id = Model.Id }, FormMethod.Post)) {
@Html.AntiForgeryToken()
<button type="submit" class="btn btn-danger">Eliminar</button>
}
@Html.ActionLink("Volver", "Index")
