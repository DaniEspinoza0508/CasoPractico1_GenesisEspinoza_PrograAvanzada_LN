@model PAP.DataAccess.PurchaseOrderItem
@{ ViewBag.Title = "Delete PurchaseOrderItem"; }
<h2>Delete PurchaseOrderItem</h2>
<p>¿Confirma que desea eliminar este registro?</p>
<dl class="dl-horizontal"><dt>Id</dt><dd>@Model.Id</dd>
<dt>PurchaseOrderId</dt><dd>@Model.PurchaseOrderId</dd>
<dt>BookId</dt><dd>@Model.BookId</dd>
<dt>Quantity</dt><dd>@Model.Quantity</dd>
<dt>UnitCost</dt><dd>@Model.UnitCost</dd></dl>
@using (Html.BeginForm("Delete", "PurchaseOrderItems", new { id = Model.Id }, FormMethod.Post)) {
@Html.AntiForgeryToken()
<button type="submit" class="btn btn-danger">Eliminar</button>
}
@Html.ActionLink("Volver", "Index")
